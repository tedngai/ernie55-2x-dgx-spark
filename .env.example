# Copy to .env.local and fill in the two nodes' deployment addresses.
# .env.local is untracked and is read by start.sh and stop.sh.

# SSH target for the worker (hostname or address).
WORKER=worker-host-or-ip

# Addresses used for the vLLM rendezvous and VLLM_HOST_IP.
HEAD_IP=169.254.x.x
WORKER_IP=169.254.x.x

# Optional overrides:
# HOST=0.0.0.0
# PORT=8000
# API_KEY=
# HF_CACHE=$HOME/.cache/huggingface
# RUNTIME_CACHE=$HOME/.cache/ernie55-runtime
# TILELANG_CACHE=$HOME/.cache/ernie55-tilelang
